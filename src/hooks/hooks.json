{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [{ "type": "command", "command": "planar", "timeout": 345600 }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "planar session-context" }]
      }
    ]
  }
}
